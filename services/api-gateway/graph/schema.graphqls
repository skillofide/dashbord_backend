"""
GraphQL schema for the SkillofIDE API Gateway.
This file is informational — the schema is defined programmatically in graph/generated/generated.go
using the graphql-go library (no code generation required).
"""

# ─── Types ────────────────────────────────────────────────────────────────────

type Problem {
  id: ID!
  slug: String!
  title: String!
  difficulty: String!
  topic: String!
  xp: Int!
  statement: String!
  constraints: [String!]!
  tags: [String!]!
  examples: [Example!]!
  hints: [Hint!]!
  starterCodes: StarterCodes
  """
  Languages this problem can actually be solved in, in display order. The
  editor must offer only these — every problem used to advertise all five
  regardless of whether a usable starter existed for them.
  """
  supportedLanguages: [String!]!
  setId: String!
  userStatus: String!
}

type Example {
  input: String!
  output: String!
  explanation: String!
}

type Hint {
  order: Int!
  title: String!
  body: String!
}

type StarterCodes {
  javascript: String!
  python: String!
  java: String!
  cpp: String!
  go: String!
}

type PracticeSet {
  id: ID!
  title: String!
  level: String!
  levelColor: String!
  bgColor: String!
  totalProblems: Int!
  progress: Float!
}

type ListProblemsResult {
  problems: [Problem!]!
  total: Int!
  page: Int!
  pageSize: Int!
}

type Submission {
  id: ID!
  userId: String!
  problemId: String!
  language: String!
  status: String!
  runtimeMs: Int!
  memoryKb: Int!
  testResults: [TestResult!]!
  submittedAt: String!
  completedAt: String
}

type TestResult {
  testCaseId: String!
  input: String!
  expectedOutput: String!
  actualOutput: String!
  status: String!
  executionMs: Int!
  error: String
}

type ListSubmissionsResult {
  submissions: [Submission!]!
  total: Int!
  page: Int!
  pageSize: Int!
}

type UserProgress {
  userId: String!
  totalSolved: Int!
  totalAttempted: Int!
  easySolved: Int!
  mediumSolved: Int!
  hardSolved: Int!
  currentStreak: Int!
  longestStreak: Int!
  totalXp: Int!
  setProgress: [SetProgress!]!
}

type SetProgress {
  setId: String!
  title: String!
  progress: Float!
  solved: Int!
  total: Int!
}

type SubmitResult {
  submissionId: String!
}

type ScratchpadResult {
  stdout: String!
  stderr: String!
  exitCode: Int!
  executionMs: Int!
  timedOut: Boolean!
}

type RunCodeResult {
  jobId: String!
  overallStatus: String!
  testResults: [TestResult!]!
  compileError: String
  runtimeMs: Int!
}

type UserProfile {
  userId: String!
  gender: String!
  dob: String!
  whatsapp: String!
  phone: String!
  experience: String!
  workExperience: String!
  careerGap: String!
  currentState: String!
  currentCity: String!
  preferredLocations: [String!]!
  githubLink: String!
  linkedinLink: String!
  isWorkingProfessional: Boolean!
  resumeName: String!
  edu10SchoolName: String!
  edu10YearOfPassout: String!
  edu10MarksPercent: String!
  edu12SchoolName: String!
  edu12YearOfPassout: String!
  edu12MarksPercent: String!
  ugUniversityRollNo: String!
  ugCollegeName: String!
  ugCourseName: String!
  ugBranch: String!
  ugYearOfPassout: String!
  ugMarksPercent: String!
  ugCgpa: String!
  ugActiveBacklogs: String!
  pgHasCertificate: Boolean!
}

input UserProfileInput {
  gender: String
  dob: String
  whatsapp: String
  phone: String
  experience: String
  workExperience: String
  careerGap: String
  currentState: String
  currentCity: String
  preferredLocations: [String!]
  githubLink: String
  linkedinLink: String
  isWorkingProfessional: Boolean
  resumeName: String
  edu10SchoolName: String
  edu10YearOfPassout: String
  edu10MarksPercent: String
  edu12SchoolName: String
  edu12YearOfPassout: String
  edu12MarksPercent: String
  ugUniversityRollNo: String
  ugCollegeName: String
  ugCourseName: String
  ugBranch: String
  ugYearOfPassout: String
  ugMarksPercent: String
  ugCgpa: String
  ugActiveBacklogs: String
  pgHasCertificate: Boolean
}

type UpsertProfileResult {
  success: Boolean!
  message: String!
}

# ─── Queries ──────────────────────────────────────────────────────────────────

type Course {
  id: ID!
  title: String!
  mentor: String!
  initial: String!
  color: String!
  classTime: String!
}

type Job {
  url: String!
  title: String!
  company: String!
  locations: String!
  description: String!
  salary: String
  date: String!
  """Board the posting came from (LinkedIn, Indeed, ...)"""
  site: String!
  """Employer logo URL, when the provider has one"""
  employerLogo: String
  """Full-time, Part-time, Contract, Internship"""
  employmentType: String
  isRemote: Boolean!
}

type JobSearchResult {
  jobs: [Job!]!
  total: Int!
  pages: Int!
}

type Query {
  listProblems(setId: String, topic: String, difficulty: String, page: Int, pageSize: Int): ListProblemsResult!
  getProblem(id: String!): Problem
  listPracticeSets: [PracticeSet!]!
  getSubmission(id: String!): Submission
  listSubmissions(problemId: String, page: Int, pageSize: Int): ListSubmissionsResult!
  getUserProgress: UserProgress!
  getProfile: UserProfile
  getMyCourses: [Course!]!
  getQuizAttempts: [QuizAttempt!]!
  searchJobs(keywords: String, location: String, page: Int): JobSearchResult!

  # ─── Placement assessments ──────────────────────────────────────────────────
  listAssessments(scope: String): [AssessmentSummary!]!
  getAttemptState(attemptId: String!): AttemptState
  getMyAttempts: [AttemptSummary!]!
  getAttemptResult(attemptId: String!): AttemptResult
  getAttemptSubmission(attemptId: String!, submissionId: String!): AttemptSubmissionStatus
}

# ─── Placement assessments ────────────────────────────────────────────────────

type AssessmentSummary {
  id: String!
  title: String!
  description: String
  purpose: String          # practice | hiring
  companyName: String
  companyLogo: String
  durationMinutes: Int
  totalMarks: Int
  questionCount: Int
  sectionSummary: String   # e.g. "20 Mcq · 2 Coding"
  opensAt: String
  closesAt: String
  maxAttempts: Int
  attemptsUsed: Int
  liveAttemptId: String    # set when there is an in-progress attempt to resume
  canStart: Boolean
  blockedReason: String
}

type McqOption {
  id: String!
  body: String!
  # Only ever populated on a revealed result — never during a live attempt.
  isCorrect: Boolean
  orderIndex: Int
}

type AttemptQuestion {
  id: String!
  sectionId: String
  kind: String             # mcq | coding | descriptive
  orderIndex: Int
  marks: Float
  body: String
  mcqKind: String          # single | multiple | numeric
  options: [McqOption!]
  problemId: String
  problemTitle: String
  selectedOptionIds: [String!]
  textAnswer: String
  submissionId: String
  language: String
  code: String
  gradingStatus: String
  visited: Boolean
  markedReview: Boolean
  timeSpentMs: Int
  awardedMarks: Float
}

type AttemptSection {
  id: String!
  title: String
  kind: String
  orderIndex: Int
  durationMinutes: Int
}

type Proctoring {
  requireFullscreen: Boolean
  tabSwitchLimit: Int
  blockCopyPaste: Boolean
  webcam: Boolean
}

type AttemptState {
  attemptId: String!
  assessmentId: String
  title: String
  status: String
  allowBacktrack: Boolean
  proctoring: Proctoring
  # serverNow/secondsLeft are the authoritative clock; the browser's own time
  # is display-only.
  serverNow: String
  expiresAt: String
  secondsLeft: Int
  sections: [AttemptSection!]
  questions: [AttemptQuestion!]
  maxScore: Float
  negativeMarking: Float
}

type AttemptSummary {
  id: String!
  assessmentId: String
  assessmentName: String
  attemptNo: Int
  status: String
  startedAt: String
  submittedAt: String
  evaluatedAt: String
  score: Float
  maxScore: Float
  percent: Float
  integrityScore: Float
  passed: Boolean
}

type AttemptResult {
  summary: AttemptSummary
  questions: [AttemptQuestion!]
  revealed: Boolean
}

type SaveAnswerResult {
  saved: Boolean
  secondsLeft: Int
}

type AttemptTestResult {
  input: String
  expectedOutput: String
  actualOutput: String
  status: String
  executionMs: Int
  error: String
}

type RunAttemptCodeResult {
  overallStatus: String
  testResults: [AttemptTestResult!]
  compileError: String
  runtimeMs: Int
}

type SubmitAttemptCodeResult {
  submissionId: String
  secondsLeft: Int
}

# Counts only — hidden test-case content is never exposed mid-test.
type AttemptSubmissionStatus {
  submissionId: String
  status: String
  passedCount: Int
  totalCount: Int
  compileError: String
  runtimeMs: Int
}

type ProctorEventResult {
  integrityScore: Float
  terminated: Boolean
  warning: String
}

input QuizAnswerInput {
  questionId: Int!
  answer: String!
}

type QuizQuestionResult {
  questionId: Int!
  correct: Boolean!
  correctAnswer: String!
}

type SubmitQuizResult {
  success: Boolean!
  score: Int!
  totalQuestions: Int!
  results: [QuizQuestionResult!]!
}

type QuizAttempt {
  moduleId: String!
  score: Int!
  totalQuestions: Int!
  selectedAnswers: String!
  completedAt: String!
}

# ─── Mutations ────────────────────────────────────────────────────────────────

type Mutation {
  submitCode(problemId: String!, language: String!, code: String!): SubmitResult!
  runCode(problemId: String!, language: String!, code: String!): RunCodeResult!
  runScratchpad(language: String!, code: String!, stdin: String): ScratchpadResult!
  upsertProfile(profile: UserProfileInput!): UpsertProfileResult!
  submitQuiz(moduleId: String!, answers: [QuizAnswerInput!]!): SubmitQuizResult!

  # ─── Placement assessments ──────────────────────────────────────────────────
  startAttempt(assessmentId: String!, inviteToken: String): AttemptState
  saveAnswer(
    attemptId: String!
    questionId: String!
    selectedOptionIds: [String!]
    textAnswer: String
    timeSpentMs: Int
    markedReview: Boolean
    clearAnswer: Boolean
  ): SaveAnswerResult
  runAttemptCode(attemptId: String!, questionId: String!, language: String!, code: String!): RunAttemptCodeResult
  submitAttemptCode(attemptId: String!, questionId: String!, language: String!, code: String!): SubmitAttemptCodeResult
  submitAttempt(attemptId: String!): AttemptSummary
  recordProctorEvent(attemptId: String!, kind: String!, detail: String): ProctorEventResult
}
